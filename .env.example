# Copy to .env for local development only. On Render, set these in the
# dashboard's Environment tab instead — never commit real values.

# The shared username reviewers will sign in with.
PORTAL_USERNAME=aspirus-review

# bcrypt hash of the shared password — generate with: node scripts/hash-password.js
# Never put the raw password here.
PORTAL_PASSWORD_HASH=

# Random signing secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your OpenAI API key, used server-side only by /api/chat.
OPENAI_API_KEY=

# development | production. Leave unset (or "production") on Render, since the
# session cookie's Secure flag is only skipped when this is "development".
NODE_ENV=development
